# Godot 4+ specific ignores
.godot/
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
mono_crash.*.json

# ── 会话级工具产物 ──────────────────────────────────────────────────────────
# DSH 视觉工具把截图/裁切产物写到这里；属于过程产物，不是交付物。
.dsh-tool-vision/

# ── 本地工具链副本：绝不入库（约 270 MB）──────────────────────────────────────
# 为什么需要这份副本：D:\saint_ruin\tools\godot\ 下的 godot.exe 在本会话中运行于
# Low Mandatory Integrity Level（Windows 强制完整性控制），它对 Medium-IL 路径的
# 每一次写入都会被**静默拒绝** —— make_dir_recursive_absolute() 返回 err=0 (OK)
# 却什么都没创建。本项目把工具链复制到本目录后 IL 恢复正常，功能可用。
# 复现证据与判定方法见 策划案/REWIND_port_plan_v1.md 附录 B 与 tools/godotprobe/REPORT.md。
tools/godot/

# 探针/临时目录（脚本运行时生成，不入库）
# ⚠ evidence/ 与 REPORT.md 是**交付物，必须入库**（原始输出就是证据），故不在此列。
tools/godotprobe/.sdkpeek/
tools/godotprobe/.tmp/
tools/godotprobe/build/
tools/godotprobe/*.log
tools/analysis/iltest/

# ── 引擎工程内的临时目录 ────────────────────────────────────────────────────
# godot/.tmp/ 会存放 nuget 缓存、VBCSCompiler 分析器、dotnet CLI home 等构建产物
# （实测可达数百 MB）。它们全部可再生，绝不入库。
godot/.tmp/
tools/solver/.tmp/

# ── .NET 构建产物（任意深度的 obj/bin 都不入库）──────────────────────────────
# 注意：早期版本写成 `godot/**/obj/`，那只覆盖 godot/ 一层；
# tools/author/ 一类的辅助工程同样会产生 obj/bin，故改为全局模式。
**/obj/
**/bin/

# ── 发行包（可由一条命令重新导出，不入库，约 180 MB）────────────────────────
# 重新生成：tools\godot\godot_console.exe --headless --path godot ^
#            --export-release "Windows Desktop" dist\REWIND.exe
# 注意：导出时 PATH 上必须先是官方 dotnet（C:\Program Files\dotnet），
# 否则 dotnet publish 失败——而 Godot 仍会返回 rc=0 并**静默产出一个空壳 exe**。
# 详见 docs/KNOWN_PITFALLS.md 与 dist/本地运行说明.md。
dist/

