; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="REWIND"
config/description="One-shot time-rewind billiards — playable demo slice."
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
run/flush_stdout_on_print=true
; The Android export refuses to run without an icon ("No project icon specified"). Generated by
; tools/make_icon.py from the game's own palette: the ivory cue ball plus the orange/amber rewind arc,
; which is the one image that states what the game is.
config/icon="res://assets/icon.png"

[autoload]

Audio="*res://src/game/Audio.cs"

[display]

window/size/viewport_width=1040
window/size/viewport_height=560
window/stretch/mode="canvas_items"
; Lock landscape on handhelds. Value 0 = Landscape; the Android export writes this into the
; manifest as screenOrientation. Written explicitly because the layout is a fixed 1040x560
; wide-format design -- the left panel plus the table -- so portrait would leave only a narrow
; strip of table between the letterbox bars.
;
; The stretch mode deliberately does NOT change per platform: with canvas_items the control
; coordinates stay identical to the desktop build pixel for pixel, so a touch coordinate maps to
; the same design point as a mouse position does on PC. A phone that is not exactly 1040:560
; gets letterbox bars instead of a re-layout, which keeps exactly one layout to reason about.
window/handheld/orientation=0

[dotnet]

project/assembly_name="RewindKernel"

[input_devices]

; Touch must drive the mouse handlers. Godot 4 defaults this to true, but it is written out
; explicitly because it is load-bearing for the entire mobile build: every interaction --
; dragging back from the cue ball to aim, tapping a card to pick it, pressing an on-screen
; button -- is implemented as mouse input. If that default ever changed, the mobile build would
; still render and animate correctly while being completely untouchable, which is the kind of
; failure that looks like nothing is wrong.
pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg")

[godot_mcp]

enabled_tools=PackedStringArray("get_project_structure", "get_debug_output", "install_runtime_probe", "remove_runtime_probe", "await_scene_ready", "get_runtime_scene_tree", "get_runtime_screenshot")

[physics]

common/physics_ticks_per_second=120
common/physics_jitter_fix=0.0
2d/default_gravity=0.0

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
; REQUIRED for Android: the engine refuses/warns on an Android export without an ETC2/ASTC
; texture compression format, because gl_compatibility on mobile has no S3TC path. The desktop
; counterpart is textures/vram_compression/import_s3tc_bptc, set in the Windows preset. The two
; are not config drift -- the engine picks the format that suits the platform.
textures/vram_compression/import_etc2_astc=true
